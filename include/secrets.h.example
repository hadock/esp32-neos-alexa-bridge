// Copy this file to secrets.h (which is gitignored) and fill in your own
// WiFi credentials before building. secrets.h is never committed -- see
// .gitignore.
//
// Sensor MACs and friendly names are NOT configured here -- they're
// auto-detected at runtime from the bridge's own paired-sensor list and
// stored in the ESP32's flash (NVS). Default names are auto-generated;
// rename a sensor any time by sending `name <MAC> <new name>` over serial
// (reboot afterwards for Alexa to pick up the new name on next discovery).

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"
